# Plantilla .env para la extensión Infinite Image Browsing (IIB).
# Se copia a <EXTENSIONS_PATH>/sd-webui-infinite-image-browsing/.env con: make iib-access
# Rutas en el contenedor: /data/output (salidas), /data/Images (carpeta de imágenes del usuario).

# Control de acceso: permitir carpetas de salida y de imágenes (rutas dentro del contenedor).
IIB_ACCESS_CONTROL=enable
IIB_ACCESS_CONTROL_ALLOWED_PATHS=txt2img,img2img,extra,save,/data/output,/data/Images
