# Rutas en el HOST. Si no defines estas variables, el compose usa por defecto
# /workspace/forge-data y /workspace/forge-extensions (persistentes en RunPod, etc.).

# Directorio base de datos (modelos, output, config.json, tmp). Se monta en /data del contenedor.
DATA_PATH=/workspace/forge-data

# Directorio de extensiones. Se monta en /data/extensions del contenedor.
EXTENSIONS_PATH=/workspace/forge-extensions

# Nombre de la subcarpeta de modelos dentro de DATA_PATH. Forge usa "models" (minúsculas) por defecto.
# Si en tu disco la carpeta se llama "Models" (mayúscula), pon: MODELS_SUBDIR=Models
MODELS_SUBDIR=models

# Carpeta de checkpoints dentro de Models. Forge espera "Stable-diffusion" por defecto.
# Si la tuya se llama "StableDiffusion" (sin guión), pon: CHECKPOINT_SUBDIR=StableDiffusion
CHECKPOINT_SUBDIR=Stable-diffusion

# Carpeta de text encoders (CLIP, etc.) dentro de Models. Forge espera "text_encoder" por defecto.
# Si la tuya se llama "TextEncoders", pon: TEXT_ENCODER_SUBDIR=TextEncoders
TEXT_ENCODER_SUBDIR=text_encoder

# Argumentos extra para el arranque de Forge (se añaden a COMMANDLINE_ARGS).
# Usar comillas si el valor contiene espacios (obligatorio para make up / make klein9b).
# Ejemplos:
# EXTRA_ARGS="--cuda-malloc --normalvram --bf16-unet"
# EXTRA_ARGS="--cuda-malloc --lowvram --fp8_e4m3fn-unet --reserve-vram 2 --disable-sage"

# Opcionales: subdirectorios bajo DATA_PATH. No hace falta definirlos
# si usas la estructura por defecto; útiles si quieres rutas distintas en el host.
# MODELS_PATH=/workspace/forge-data/models
# OUTPUT_PATH=/workspace/forge-data/output
# CONFIG_PATH=/workspace/forge-data
