diff --git a/backend/attention.py b/backend/attention.py
index f349ee2c..59382311 100644
--- a/backend/attention.py
+++ b/backend/attention.py
@@ -380,18 +380,26 @@ def attention_flash(q, k, v, heads, mask=None, attn_precision=None, skip_reshape
         if mask.ndim == 3:
             mask = mask.unsqueeze(1)
 
-    try:
-        assert mask is None
-        out = flash_attn_wrapper(
-            q.transpose(1, 2),
-            k.transpose(1, 2),
-            v.transpose(1, 2),
-            dropout_p=0.0,
-            causal=False,
-        ).transpose(1, 2)
-        _fallback = False
-    except Exception as e:
-        logger.error(f"Error running flash_attn: {e}")
+    # flash_attn's CUDA kernel only supports unmasked (optionally causal) attention. Callers that
+    # need an attn_mask/bias (Qwen-Image joint attention padding, Krea2 Identity Edit's ref_boost
+    # logit bias) always land here with a real tensor, so the previous "assert mask is None" inside
+    # the try/except turned an expected routing decision into an ERROR log on every block of every
+    # step. Route straight to scaled_dot_product_attention when masked (no wasted flash call, no
+    # log spam) and keep the try/except only for genuine flash execution failures (mask is None).
+    if mask is None:
+        try:
+            out = flash_attn_wrapper(
+                q.transpose(1, 2),
+                k.transpose(1, 2),
+                v.transpose(1, 2),
+                dropout_p=0.0,
+                causal=False,
+            ).transpose(1, 2)
+            _fallback = False
+        except Exception as e:
+            logger.error(f"Error running flash_attn: {e}")
+            _fallback = True
+    else:
         _fallback = True
 
     if _fallback:
